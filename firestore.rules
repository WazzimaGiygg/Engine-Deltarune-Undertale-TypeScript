rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Player Cloud Save Slots
      match /saves/{slotId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) 
                              && isValidId(userId) 
                              && isValidId(slotId) 
                              && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(slotId);
      }

      // Player Achievements & Milestones
      match /achievements/{achievementId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) 
                              && isValidId(userId) 
                              && isValidId(achievementId) 
                              && request.resource.data.userId == request.auth.uid
                              && request.resource.data.achievementId is string
                              && request.resource.data.title is string
                              && request.resource.data.unlockedAt is string;
        allow delete: if isOwner(userId) && isValidId(achievementId);
      }
    }

    // Global Leaderboard between registered players
    match /leaderboard/{userId} {
      allow read, list: if isSignedIn();
      allow create, update: if isOwner(userId) 
                            && isValidId(userId) 
                            && request.resource.data.userId == request.auth.uid 
                            && request.resource.data.score is number 
                            && request.resource.data.lv is number 
                            && request.resource.data.displayName is string 
                            && request.resource.data.displayName.size() <= 64;
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
